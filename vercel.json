{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/guts-gigaflops",
      "destination": "/guts-gigaflops/index.html"
    },
    {
      "source": "/guts-gigaflops/",
      "destination": "/guts-gigaflops/index.html"
    },
    {
      "source": "/reports/guts_gigaflops.html",
      "destination": "/guts-gigaflops/index.html"
    }
  ]
}